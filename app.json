{
  "expo": {
    "name": "WortKrieg",
    "slug": "wortkrieg",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wortkrieg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },

    "ios": {
      "bundleIdentifier": "com.wortkrieg.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WortKrieg telaffuz alıştırmaları için mikrofonunuza ihtiyaç duyar.",
        "NSSpeechRecognitionUsageDescription": "WortKrieg telaffuzunuzu değerlendirmek için konuşma tanıma kullanır.",
        "UIBackgroundModes": ["audio"],
        "LSApplicationQueriesSchemes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.wortkrieg.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0D1B2A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B2A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A73E8",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "WortKrieg telaffuz alıştırmaları için mikrofonunuza ihtiyaç duyar."
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "wortkrieg-app"
      }
    }
  }
}
